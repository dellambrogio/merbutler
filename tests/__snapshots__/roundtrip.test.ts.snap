// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`round-trip > all-shapes.mmd 1`] = `
"flowchart LR
  a[rectangle]
  b(rounded)
  c([stadium])
  d[[subroutine]]
  e[(database)]
  f((circle))
  g>flag]
  h{decision}
  i{{hexagon}}
  j[/parallelogram/]
  k[/trapezoid\\]
  l(((double circle)))
  m[\\lean left\\]
  n[\\inverted trapezoid/]
  a --> b
  b --> c
  c --> d
  e --> f
  f --> g
  g --> h
  i --> j
  j --> k
  k --> l
  m --> n
"
`;

exports[`round-trip > assets.mmd 1`] = `
"flowchart LR
  user@{ icon: "fa:user", form: "square", label: "User Icon", pos: "t", h: 60 }
  bare@{ icon: "mdi:cloud" }
  odd@{ icon: "fa:gear", form: "blob", label: "**Bold** gear" }
  pic@{ img: "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E", label: "Inline", w: 80, h: 40, constraint: "on" }
  remote@{ img: "https://example.com/logo.png", label: "Remote", pos: "b" }
  user --> pic
  pic --> remote
  bare -.-> odd
"
`;

exports[`round-trip > at-shapes.mmd 1`] = `
"flowchart LR
  a@{ shape: diam, label: "Decision" }
  b@{ shape: database, label: "Alias of cyl" }
  c@{ shape: rounded }
  d@{ shape: circle, label: "**bold** and *italic*" }
  e@{ shape: trap-t, label: "Line one<br/>Line two" }
  f@{ shape: hex, label: "Quotes #quot;x#quot;, #35;35; {braces} a\\\\b" }
  g((Bracket circle))
  g --> a
  a --> b
  a --> c
  d -.-> e
  e ==> f
"
`;

exports[`round-trip > basic.mmd 1`] = `
"flowchart LR
  A[Start]
  B{Ok?}
  C(Done)
  D([Retry])
  E((Circle))
  F
  A --> B
  B -->|yes| C
  B -.->|no| D
  D ==> A
  E --- C
"
`;

exports[`round-trip > chain.mmd 1`] = `
"flowchart TB
  start([Begin])
  step1[Load data]
  step2{Valid?}
  done((End))
  start --> step1
  step1 --> step2
  step2 -->|yes| done
  step2 -->|no| step1
"
`;

exports[`round-trip > edge-ends.mmd 1`] = `
"flowchart LR
  A
  B
  C
  D
  E
  F
  G
  H
  A --> B
  B --- C
  C -.-> D
  D ==> E
  E --o F
  F --x G
  G <--> H
"
`;

exports[`round-trip > edge-ids.mmd 1`] = `
"flowchart LR
  client
  api
  db
  cache
  log
  client e1@--> api
  api e2@==>|cache miss| db
  api e3@---> cache
  api --> log
  e1@{ animate: true }
  e2@{ animation: slow, step: 2 }
  e3@{ step: 1, curve: linear }
"
`;

exports[`round-trip > edge-lengths.mmd 1`] = `
"flowchart TB
  A
  B
  C
  D
  E
  F
  G
  H
  I
  J
  K
  A ---> B
  A ----> C
  A ---- D
  A -..-> E
  A -...- F
  A ===> G
  A <===> H
  A --o I
  A ---x J
  A --->|long| K
"
`;

exports[`round-trip > graph-td.mmd 1`] = `
"flowchart TB
  a
  b
  c
  d
  a --> b
  a --> c
  b --> d
  c --> d
"
`;

exports[`round-trip > interaction.mmd 1`] = `
"flowchart LR
  A
  B
  C
  D
  E
  F
  x
  subgraph one [My Group]
    a1[click a1 is a label, not a statement]
    a2
    subgraph inner
      a3
    end
  end
  A --> B
  B --> C
  C --> D
  D --> E
  E --> F
  a1 --> a2
  x --> a1
  a2 --> a3
  one@{ view: collapsed }
  inner@{ view: expanded }
  click A callback "Tip A"
  click B "https://www.github.com" "Tip; with semicolon"
  click C call cb(1, "x") "Tip C"
  click D href "https://x.org" "Tip D" _blank
  click E "https://e.org" _blank
  click F call cb()
"
`;

exports[`round-trip > invisible.mmd 1`] = `
"flowchart TB
  a
  b
  c
  d
  a ~~~ b
  a ~~~~ c
  b --> d
  c ~~~|hidden label| d
"
`;

exports[`round-trip > open-edges.mmd 1`] = `
"flowchart BT
  x
  y
  z
  x -.- y
  y === z
  z ---|plain label| x
"
`;

exports[`round-trip > preamble.mmd 1`] = `
"---
title: Checkout
config:
  look: classic
  flowchart:
    curve: stepBefore
---
%% Kept: comments before the flowchart line
flowchart LR
  cart
  pay
  cart --> pay
"
`;

exports[`round-trip > rich-text.mmd 1`] = `
"flowchart LR
  A["Text with (parens) & symbols"]
  B["\`**bold** and *italic*\`"]
  C["line one<br>line two"]
  A --> B
  B --> C
"
`;

exports[`round-trip > special-text.mmd 1`] = `
"flowchart RL
  q["Say #quot;hi#quot; (now)"]
  r["x [y] {z}"]
  s["ünïcode: ✓"]
  q -->|"a | b"| r
  r --> s
"
`;

exports[`round-trip > styling.mmd 1`] = `
"flowchart LR
  A
  B
  C
  subgraph grp [Group]
    D
  end
  A --> B
  B e1@--> C
  C --> D
  classDef hot fill:#f96,stroke:#333,stroke-width:4px
  classDef cold color:#00f
  classDef warm color:#00f
  classDef default fill:#eee
  classDef dashed stroke-dasharray: 9\\,5,stroke-dashoffset: 900
  class A,D hot
  class D,grp cold
  class B,C warm
  class e1 dashed
  class D alpha
  class D zeta
  style A color:#fff
  style grp fill:#ffe,stroke:#cc0
  linkStyle default interpolate basis
  linkStyle default stroke:#999
  linkStyle 0 stroke:#f00,stroke-width:3px
  linkStyle 2 interpolate linear
"
`;

exports[`round-trip > subgraph-edges.mmd 1`] = `
"flowchart LR
  subgraph ingest [Ingestion]
    direction TB
    a1[fetch]
    a2[parse]
  end
  subgraph store [Storage]
    b1[(db)]
  end
  a1 --> a2
  ingest --> store
"
`;

exports[`round-trip > subgraph-empty.mmd 1`] = `
"flowchart TB
  x
  y
  subgraph s1 [Empty group]
  end
  x --> y
"
`;

exports[`round-trip > subgraphs.mmd 1`] = `
"flowchart LR
  start
  e
  subgraph outer [Outer box]
    direction TB
    a[A]
    subgraph inner ["Inner #quot;x#quot;"]
      b((B))
    end
  end
  subgraph plain
    c
  end
  subgraph subGraph3 [Title with spaces]
    d
  end
  start --> a
  a --> b
  b --> c
  c --> e
  d -.-> a
"
`;
